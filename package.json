{
  "name": "maplestory-platformer",
  "version": "3.0.0",
  "description": "楓之谷風格平台遊戲（盜賊傳說）— Phaser 3 多檔案架構",
  "main": "src/main.js",
  "engines": {
    "node": ">=18"
  },
  "author": "ali-bobo",
  "repository": {
    "type": "git",
    "url": "https://github.com/ali-bobo/maplestory-platformer"
  },
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "serve": "npx serve . -l tcp://127.0.0.1:3000",
    "play": "npx --yes serve . -l tcp://127.0.0.1:3000",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "phaser": "^3.88.2",
    "phaser3-rex-plugins": "^1.80.20"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "overrides": {
    "i18next-http-backend": "3.0.5"
  }
}
